<?php

/**
 * @file
 * Functions to support theming in the indie theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function indie_preprocess_html(&$variables) {

}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function indie_preprocess_page(&$variables) {

}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function indie_preprocess_node(&$variables) {
  $node = $variables['node'];
  $variables['date'] = \Drupal::service('date.formatter')
    ->format($node->getCreatedTime(), 'custom', 'F j, Y');
  $variables['display_submitted'] = FALSE;
}

/**
 * Implements hook_preprocess_HOOK() for media.html.twig.
 */
function indie_preprocess_media(&$variables) {
  $media = $variables['media'];
  if ($variables['view_mode'] === 'gallery' && $media->bundle() === 'image') {
    $image_field = $media->get('field_media_image');
    if (!$image_field->isEmpty()) {
      $image = $image_field->entity;
      $style = \Drupal::entityTypeManager()
        ->getStorage('image_style')
        ->load('gallery_full');
      $variables['gallery_full_url'] = $style
        ? $style->buildUrl($image->getFileUri())
        : \Drupal::service('file_url_generator')->generateAbsoluteString($image->getFileUri());
      $variables['gallery_alt'] = $image_field->alt ?? '';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view.html.twig.
 */
function indie_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  if ($view->id() === 'gallery') {
    $variables['#attached']['library'][] = 'indie/gallery';
  }
}
