{#
/**
 * @file
 * Footer menu template with pixelarticon classes based on URL path.
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes }}>
    {% else %}
      <ul>
    {% endif %}
    {% for item in items %}
      {% set url_string = item.url.toString() %}
      {% set icon_class = '' %}
      {% if 'rss' in url_string %}
        {% set icon_class = 'menu-item--rss' %}
      {% elseif 'contact' in url_string %}
        {% set icon_class = 'menu-item--contact' %}
      {% elseif 'github' in url_string %}
        {% set icon_class = 'menu-item--github' %}
      {% endif %}
      <li{{ item.attributes.addClass(icon_class) }}>
        {{ link(item.title, item.url) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
