{#
/**
 * @file
 * Default theme implementation to display a node.
 *
 * Full content view with structured layout:
 * - Meta line (category + date)
 * - Image
 * - Body/description
 * - Recipe metadata row (yield, times)
 * - Recipe sections (ingredients, instructions, notes, source)
 * - Tags
 */
#}

{% set recipe_fields = [
  'field_category',
  'field_recipe_image',
  'field_image',
  'field_recipe_tags',
  'field_tags',
  'recipe_description',
  'body',
  'recipe_yield',
  'recipe_prep_time',
  'recipe_cook_time',
  'recipe_total_time',
  'recipe_ingredient',
  'recipe_instructions',
  'recipe_notes',
  'recipe_source',
  'field_net_carbs',
] %}

<article{{ attributes }}>

  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {# Meta line: category + date #}
  <div class="node-full__meta">
    {% if content.field_category|render|trim %}
      <span class="node-full__category">{{ content.field_category }}</span>
      <span class="node-full__separator">&middot;</span>
    {% endif %}
    <span class="node-full__date">{{ date }}</span>
  </div>

  {# Image #}
  {% if content.field_recipe_image|render|trim %}
    <div class="node-full__image">
      {{ content.field_recipe_image }}
    </div>
  {% elseif content.field_image|render|trim %}
    <div class="node-full__image">
      {{ content.field_image }}
    </div>
  {% endif %}

  {# Body/description #}
  {% if content.recipe_description|render|trim %}
    <div class="node-full__body">
      {{ content.recipe_description }}
    </div>
  {% elseif content.body|render|trim %}
    <div class="node-full__body">
      {{ content.body }}
    </div>
  {% endif %}

  {# Recipe metadata row: yield, prep, cook, total #}
  {% set has_recipe_meta = content.recipe_yield|render|trim
    or content.recipe_prep_time|render|trim
    or content.recipe_cook_time|render|trim
    or content.recipe_total_time|render|trim %}

  {% if has_recipe_meta %}
    <div class="node-full__recipe-meta">
      {% if content.recipe_yield|render|trim %}
        <div class="node-full__recipe-meta-item">
          {{ content.recipe_yield }}
        </div>
      {% endif %}
      {% if content.recipe_prep_time|render|trim %}
        <div class="node-full__recipe-meta-item">
          {{ content.recipe_prep_time }}
        </div>
      {% endif %}
      {% if content.recipe_cook_time|render|trim %}
        <div class="node-full__recipe-meta-item">
          {{ content.recipe_cook_time }}
        </div>
      {% endif %}
      {% if content.recipe_total_time|render|trim %}
        <div class="node-full__recipe-meta-item">
          {{ content.recipe_total_time }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {# Recipe sections: ingredients, instructions, notes, source #}
  {% if content.recipe_ingredient|render|trim %}
    <div class="node-full__section">
      {{ content.recipe_ingredient }}
    </div>
  {% endif %}

  {% if content.recipe_instructions|render|trim %}
    <div class="node-full__section">
      {{ content.recipe_instructions }}
    </div>
  {% endif %}

  {% if content.recipe_notes|render|trim %}
    <div class="node-full__section">
      {{ content.recipe_notes }}
    </div>
  {% endif %}

  {% if content.recipe_source|render|trim %}
    <div class="node-full__section">
      {{ content.recipe_source }}
    </div>
  {% endif %}

  {% if content.field_net_carbs|render|trim %}
    <div class="node-full__section">
      {{ content.field_net_carbs }}
    </div>
  {% endif %}

  {# Tags #}
  {% if content.field_recipe_tags|render|trim %}
    <div class="node-tags">{{ content.field_recipe_tags }}</div>
  {% elseif content.field_tags|render|trim %}
    <div class="node-tags">{{ content.field_tags }}</div>
  {% endif %}

  {# Remaining fields not explicitly placed #}
  <div{{ content_attributes }}>
    {{ content|without(recipe_fields) }}
  </div>

</article>
